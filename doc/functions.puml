@startuml

package "考勤管理系统" {

    package "员工管理" {
        [员工信息管理]
    }

    package "考勤管理" {
        [考勤规则管理]
        [考勤记录管理]
        [请假管理]
        [加班管理]
        [考勤统计和报表]
    }

    package "系统管理" {
        [权限管理]
        [系统设置]
        [审批流程管理]
    }

    package "通知与提醒" {
        [考勤提醒和通知]
    }

    [员工信息管理] --> [权限管理]
    [员工信息管理] --> [考勤记录管理]

    [考勤记录管理] --> [考勤统计和报表]
    [考勤记录管理] --> [加班管理]
    [考勤记录管理] --> [请假管理]
    [考勤记录管理] --> [考勤提醒和通知]

    [请假管理] --> [审批流程管理]
    [加班管理] --> [审批流程管理]

    [系统设置] --> [权限管理]
    [系统设置] --> [审批流程管理]

}

@enduml
